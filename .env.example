VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Demo mode: when both are set, the app auto-signs-in with this account on
# load instead of showing the login form. Create the account once via the
# app's own /register flow, then fill in its real credentials here.
# VITE_DEMO_EMAIL=""
# VITE_DEMO_PASSWORD=""

# ── Edge Function secrets (NOT frontend variables) ──────────────────────────
# Listed here for discoverability only. These must never appear in a VITE_
# variable or in any file under version control — anything prefixed VITE_ is
# compiled into the JavaScript bundle and served to every visitor.
#
# Set them with:
#   supabase secrets set BANKHUB_CLIENT_ID=... BANKHUB_SECRET_KEY=...
#
#   BANKHUB_CLIENT_ID      Cas partner id       (console.bankhub.dev)
#   BANKHUB_SECRET_KEY     Cas partner secret   (different per environment)
#   BANKHUB_ENV            "sandbox" (default) or "production"
#   BANKHUB_REDIRECT_URIS  Comma-separated. The function picks the one whose
#                          origin matches the caller's Origin header, so one
#                          deployment serves both localhost and production.
#                          Every value must also be registered in the Cas
#                          console; an unregistered one is refused with
#                          INVALID_PARAM before Cas Link even opens.
#   PQC_KYC_PUBLIC_KEY     ML-KEM-768 keypair, also used to encrypt the Cas
#   PQC_KYC_PRIVATE_KEY    accessToken at rest
#   SEPAY_WEBHOOK_KEY      only if the SePay webhook path is used
